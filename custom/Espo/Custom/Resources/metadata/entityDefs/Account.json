            "style": {
                "Calle": null,
                "Vía": null,
                "Avenida": null,
                "Plaza": null,
                "Paseo": null,
                "Carretera": null,
                "Camino": null,
                "Polígono": null,
                "Parque": null,
                "Otro": null
